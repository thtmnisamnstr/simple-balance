{
  "name": "simple-balance",
  "version": "0.1.6",
  "description": "Self-hosted personal accounting: every account in one place, statements that import themselves, and reports that add up.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tests *.ts",
    "format:check": "oxfmt --check src tests *.ts",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts tests/integration",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "set-version": "node scripts/set-version.mjs",
    "ralph": "./scripts/ralph/ralph.sh",
    "test:browser": "playwright test"
  },
  "overrides": {
    "@napi-rs/wasm-runtime": "1.1.6",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "1.6.33",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "nodemailer": "^9.1.1",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
