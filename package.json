{
  "name": "simple-balance",
  "version": "0.1.6",
  "description": "Personal finance that's simple. Every account on one page, with a running balance beside every row, so a total you doubt opens into the entries behind it.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "capacity:seed": "node scripts/capacity/seed.mjs",
    "capacity:verify": "node scripts/capacity/verify.mjs",
    "capacity:credentials": "node scripts/capacity/credentials.mjs",
    "capacity:load": "node scripts/capacity/load.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tests *.ts",
    "format:check": "oxfmt --check src tests *.ts",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts tests/integration",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "set-version": "node scripts/set-version.mjs",
    "ralph": "./scripts/ralph/ralph.sh",
    "test:browser": "playwright test"
  },
  "overrides": {
    "@napi-rs/wasm-runtime": "1.1.6",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@stripe/react-stripe-js": "6.10.0",
    "@stripe/stripe-js": "9.16.0",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "1.6.33",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "nodemailer": "^10.0.14",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.82.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
