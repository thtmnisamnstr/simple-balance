# Installed and built output
node_modules/
dist/
*.tsbuildinfo

# Local configuration. The example is the template and stays tracked.
.env
.env.*
!.env.example

# Test and tooling output
coverage/
playwright-report/
test-results/
.ralph/
outputs/
*.log

# Editor and operating system leftovers
.DS_Store
.idea/
.vscode/

# Agent worktrees, which are whole checkouts of this repo.
.claude/worktrees/

# Scratch trees a verification agent may leave behind. They are diagnostics,
# never deliverables, and one committed by accident runs in every CI leg.
tests/tmp*/
tests/zz-*

# Throwaway probes. A review or an audit sometimes needs to run a script against
# the real modules, which means writing it inside the repository so it can import
# them — and one such file was committed by a `git add -A` that ran while it was
# on disk, along with a mutation to a source file that happened to be applied at
# that moment. Ignored so the next one cannot be.
.audit*.mts
.review*.mts
.verify*.mts
.probe*.mts
