# Copied to /etc/default/simple-balance and read by every unit in
# deploy/systemd/. It holds only what systemd itself has to know; everything
# else belongs in /opt/simple-balance/.env, which Compose reads.

# Which compose files make up the deployment, colon separated. Docker Compose
# reads this name natively, and it is the one line that differs between the two
# machines of this profile: the database machine sets
# `COMPOSE_FILE=compose.postgres.yml` and runs the same unit over that project
# instead. Nothing else in this file has to change for it.
#
# Drop the second entry if something other than Caddy terminates TLS — and set
# TRUST_PROXY=true in .env yourself, because that is what the overlay was doing
# for you.
#
# Add compose.db-tls.yml as a third entry when DATABASE_URL names the
# database's CA certificate with sslrootcert, after making
# /var/lib/simple-balance/tls and putting the certificate in it;
# deploy/compose/single/README.md, "The database's certificate", has the steps.
# It is what the cloud programs set, because a database node they built is
# always reached under sslmode=verify-full. It is not the default here because
# the overlay refuses to start without that directory, and a deployment that
# names no certificate has no reason to make one — nor, under a rootless daemon,
# the permission to.
COMPOSE_FILE=compose.yml:compose.caddy.yml

# Where a postgres client is taken from, for the machines that need one. An
# application machine's database is on another host, so the backup and restore
# scripts have nothing to exec into and run pg_dump from this image instead. The
# database machine has the server as a service in its own project and never
# reads this: the dump goes through `docker compose exec`, in the server's own
# image, which cannot be the wrong version.
#
# Pinned rather than floating: a pg_dump older than the server it is dumping
# refuses outright, so which version this reaches for should be a decision.
SB_PG_CLIENT_IMAGE=postgres:18

# The CA bundle the backup and restore hand their client under
# sslmode=verify-full with no sslrootcert, which is how a database with a
# certificate from a public authority is checked. Unset, they take the first of
# /etc/ssl/certs/ca-certificates.crt, /etc/pki/tls/certs/ca-bundle.crt,
# /etc/ssl/ca-bundle.pem and /etc/ssl/cert.pem that exists, so this is only for
# a host whose bundle is in none of them. Never used under verify-ca, which
# checks the chain and not the name and would take any public CA's certificate
# for any host as the database's.
# SB_PG_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Where dumps are written, and how many to keep. The useful question is whether
# this directory is on a disk that survives the machine.
#
# How much of that disk it wants is (SB_BACKUP_KEEP + 1) x 0.145 x the live
# ledger — plus one because the dump being written sits beside the fourteen
# kept until it has verified, which simple-balance-backup explains where it
# prunes. 0.145 is measured rather than rounded: a pg_dump -Fc of the database
# docs/deployment-sizing.md measures came to 8.7 MB of 60, and every disk figure
# in that document derives from it. A household ledger makes that a few
# megabytes and the number is not worth thinking about. A ledger at the top of
# docs/capacity.md — 30 million transactions, 37.44 GB — makes it 81 GB,
# and there it is the largest single thing on the application node's disk:
# lower this to 3 and copy the dumps off instead.
SB_BACKUP_DIR=/var/backups/simple-balance
SB_BACKUP_KEEP=14
