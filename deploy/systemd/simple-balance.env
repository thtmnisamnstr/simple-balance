# Copied to /etc/default/simple-balance and read by every unit in
# deploy/systemd/. It holds only what systemd itself has to know; everything
# else belongs in /opt/simple-balance/.env, which Compose reads.

# Which compose files make up the deployment, colon separated. Docker Compose
# reads this name natively. Drop the second entry if something other than Caddy
# terminates TLS — and set TRUST_PROXY=true in .env yourself, because that is
# what the overlay was doing for you.
COMPOSE_FILE=compose.yml:compose.caddy.yml

# Where a postgres client is taken from, for the deployments that need one.
# `single` points at a database somebody else keeps, so the backup and restore
# scripts have nothing to exec into and run pg_dump from this image instead.
# `vps` has the database as a service and never reads this.
#
# Pinned rather than floating: a pg_dump older than the server it is dumping
# refuses outright, so which version this reaches for should be a decision.
SB_PG_CLIENT_IMAGE=postgres:18

# Where dumps are written, and how many to keep. Fourteen daily dumps of a
# ledger is a small number of megabytes; the useful question is whether this
# directory is on a disk that survives the machine.
SB_BACKUP_DIR=/var/backups/simple-balance
SB_BACKUP_KEEP=14
