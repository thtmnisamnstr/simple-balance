#!/bin/sh
# A dump of the ledger, taken from the running deployment and written to
# SB_BACKUP_DIR. Run by simple-balance-backup.timer, and safe to run by hand.
#
#   sudo /usr/local/bin/simple-balance-backup
#
# What this is not: a substitute for the database's own files surviving. A dump
# is a copy of the data, not of the machine, and the useful question about
# SB_BACKUP_DIR is whether it is on something that outlives the host.
set -eu

# Not bash, so no pipefail. Every pipeline below is therefore written so the
# command that can fail is the last one, or its result is checked on its own.
# This matters most for pg_dump: in `pg_dump | gzip`, a failed dump and a
# successful gzip produce exit 0 and an empty archive, which is a backup that
# reports success and restores nothing.

: "${SB_COMPOSE_DIR:=/opt/simple-balance}"
: "${SB_BACKUP_DIR:=/var/backups/simple-balance}"
: "${SB_BACKUP_KEEP:=14}"
# Only used where the database is not part of the deployment. Pinned rather than
# floating: a pg_dump older than the server refuses outright, so the version this
# reaches for should be a decision. 18 is what the profiles that own a database
# deploy, and pg_dump 18 dumps every server this application supports. Its
# pg_restore does not load straight into a 15 or 16 server — it opens with a
# setting those do not have — so simple-balance-restore renders the dump to SQL
# for an older server first, before it touches anything.
: "${SB_PG_CLIENT_IMAGE:=postgres:18}"

# Two profiles reach their database two different ways, and this is the one
# script both use.
#
# `vps` has the database as a service in this same Compose project, so the dump
# is taken inside it and needs no client on the host and no password anywhere.
# `single` points at a database somebody else keeps, so there is nothing to exec
# into — the dump goes over the network, from a client container, using the same
# DATABASE_URL the application uses.
#
# Decided by reading the project's own service list rather than by a setting. A
# setting here would be a second place to state something the compose file
# already says, and the failure when the two disagree is a backup that reports
# success and dumps the wrong database.
cd "$SB_COMPOSE_DIR"
if docker compose config --services 2>/dev/null | grep -qx postgres; then
	database_in_project=yes
else
	database_in_project=no
fi

# libpq's spelling of DATABASE_URL, for the postgres client. The application
# reads the same string with node-postgres, and the two disagree about sslmode:
# `no-verify`, node-postgres's word for encrypted and not verified, is not
# libpq's, and libpq refuses it outright with `invalid sslmode value` — so a
# deployment configured that way could be neither dumped nor restored. libpq's
# `require` is the same guarantee, and nothing below mounts a root certificate
# for it that would quietly turn it into verify-ca. `uselibpqcompat`, which
# tells node-postgres to read `require` libpq's way, is an unknown URI
# parameter to libpq and is refused the same way, so it is dropped. Every other
# parameter passes through untouched, `sslrootcert` included: libpq_root_cert
# below is what makes the file it names readable to the client.
#
# The same function, spelled the same way, is in the other script of the pair;
# tests/systemd-scripts.test.ts holds the two to each other and to its cases.
libpq_url() {
	printf '%s\n' "$1" | sed \
		-e 's/\([?&]\)sslmode=no-verify$/\1sslmode=require/' \
		-e 's/\([?&]\)sslmode=no-verify&/\1sslmode=require\&/' \
		-e 's/[?&]uselibpqcompat=[^&]*$//' \
		-e 's/\([?&]\)uselibpqcompat=[^&]*&/\1/'
}

# The file of trusted certificates the client container has to be able to read
# for libpq to check the database's, or nothing when it has no need of one.
#
# The client is a stock postgres image, and it trusts nothing: it has no CA
# bundle at all, and `sslrootcert=system` there means OpenSSL's default path,
# which in that image is a symlink to a file that is not installed. So a
# verified connection has to bring its roots with it, and there are two
# places they can come from.
#
# The file DATABASE_URL names in `sslrootcert`, mounted at that same path. That
# is what makes one string mean one file to both readers: node-postgres reads
# `sslrootcert` as a path and loads it as the only CA it trusts, libpq does the
# same, and compose.db-tls.yml mounts /var/lib/simple-balance/tls into the
# application at the path it has here.
#
# Otherwise this machine's own CA bundle, for a database whose certificate is
# from a public authority: the application checks that against the roots Node
# carries, and this is the nearest thing the client can have. SB_PG_CA_BUNDLE
# names it where it is in none of the usual places. Under verify-full only.
# verify-ca checks the chain and not the name, and a chain to some public CA
# is what anybody can get for a host they control, so the bundle under
# verify-ca would take any such server's certificate for the database's —
# which is why libpq refuses verify-ca with sslrootcert=system, the same trust
# by another name. The application reads verify-ca as verify-full and checks
# the name, so there it would be the backup alone handing the password over.
#
# Only for verify-ca and verify-full, and never for the modes that worked
# before them. `no-verify` reaches libpq as `require`, and libpq handed a root
# file under `require` checks the chain with it — so mounting the file there
# would refuse a server the application does not check, and a backup that ran
# last night would stop. Under every other mode nothing is mounted and the URL
# passes through as it always did: a `sslrootcert` libpq cannot find inside the
# container is one it goes on without. Under a verify mode it would refuse
# instead, with a message about a path in a container nobody can see, so this
# refuses first and says which path, on this machine, it looked for.
#
# Printed on stdout, reasons on stderr, and the same in both scripts.
libpq_root_cert() {
	sb_mode=$(printf '%s\n' "$1" | sed -n 's/^[^?]*?\(.*&\)\{0,1\}sslmode=\([^&]*\).*$/\2/p')
	case "$sb_mode" in
	verify-ca | verify-full) ;;
	*) return 0 ;;
	esac
	sb_root=$(printf '%s\n' "$1" | sed -n 's/^[^?]*?\(.*&\)\{0,1\}sslrootcert=\([^&]*\).*$/\2/p')
	if [ -n "$sb_root" ]; then
		# A comma would end --mount's source. A %XX is decoded by both readers,
		# and a + into a space by node-postgres alone, so each names a file
		# other than the one that would be mounted.
		case "$sb_root" in
		/*[%,+]*) sb_why="has a %, a + or a comma in it; write the path as it is on disk" ;;
		/*)
			if [ -f "$sb_root" ] && [ -r "$sb_root" ]; then
				printf '%s\n' "$sb_root"
				return 0
			fi
			sb_why="is not a file this machine has, or not one root can read"
			;;
		*) sb_why="is not an absolute path. The application reads sslrootcert as a file too, so \`system\` and a relative name fail there as well" ;;
		esac
		echo "${0##*/}: sslrootcert=$sb_root in DATABASE_URL $sb_why." >&2
		echo "  Put the database's CA certificate in /var/lib/simple-balance/tls/db-ca.pem and name that." >&2
		return 1
	fi
	if [ "$sb_mode" = verify-ca ]; then
		echo "${0##*/}: sslmode=verify-ca in DATABASE_URL, with no sslrootcert, would take a certificate any public CA issued, for any name, as the database's." >&2
		echo "  Use sslmode=verify-full, which is how the application reads it already, or put the database's CA certificate in /var/lib/simple-balance/tls/db-ca.pem and name that." >&2
		return 1
	fi
	if [ -n "${SB_PG_CA_BUNDLE:-}" ]; then
		set -- "$SB_PG_CA_BUNDLE"
	else
		set -- /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
			/etc/ssl/ca-bundle.pem /etc/ssl/cert.pem
	fi
	for sb_bundle in "$@"; do
		if [ -f "$sb_bundle" ] && [ -r "$sb_bundle" ]; then
			printf '%s\n' "$sb_bundle"
			return 0
		fi
	done
	echo "${0##*/}: sslmode=$sb_mode in DATABASE_URL, with no sslrootcert, and no CA bundle on this machine at $*." >&2
	echo "  Name the database's CA certificate with sslrootcert, or the bundle with SB_PG_CA_BUNDLE." >&2
	return 1
}

# `single` needs the connection string, and it lives in the file Compose reads.
# Read out of it with its quotes removed, so an operator who quoted it gets the
# same value Compose would see.
if [ "$database_in_project" = no ]; then
	if [ -z "${DATABASE_URL:-}" ] && [ -r "$SB_COMPOSE_DIR/.env" ]; then
		DATABASE_URL=$(sed -n 's/^DATABASE_URL=//p' "$SB_COMPOSE_DIR/.env" | tail -1 | sed 's/^"\(.*\)"$/\1/; s/^'"'"'\(.*\)'"'"'$/\1/')
	fi
	if [ -z "${DATABASE_URL:-}" ]; then
		echo "simple-balance-backup: no postgres service in this deployment and no DATABASE_URL to dump from." >&2
		echo "  This is the \`single\` profile, whose database is somebody else's. Put DATABASE_URL in" >&2
		echo "  $SB_COMPOSE_DIR/.env, which is where the application reads it from too." >&2
		exit 2
	fi
	pg_url=$(libpq_url "$DATABASE_URL")
	# Decided before the dump starts, so a certificate that is missing is said
	# once, plainly, rather than as libpq's complaint about a path in a
	# container that has already gone.
	pg_ca_file=$(libpq_root_cert "$pg_url") || exit 2
fi

# One place that decides how a postgres client is run, so the dump and the
# verification below cannot end up reaching two different databases.
#
# --network host because DATABASE_URL is written from the host's point of view:
# a managed database is reachable either way, but one on this machine's own
# loopback is only reachable this way, and that is a deployment somebody will
# have.
#
# --mount rather than -v for the certificate, because -v creates a missing
# source as a directory, and a directory called db-ca.pem is where the operator
# would then copy the real file into and wonder why nothing reads it.
# PGSSLROOTCERT names the same file: a URL that says sslrootcert overrides it
# with the same path, and one that does not gets the bundle from it.
pg() {
	if [ "$database_in_project" = yes ]; then
		docker compose exec -T postgres "$@"
	elif [ -n "${pg_ca_file:-}" ]; then
		docker run --rm -i --network host -e PGCONNECT_TIMEOUT=15 \
			--mount "type=bind,source=$pg_ca_file,target=$pg_ca_file,readonly" \
			-e "PGSSLROOTCERT=$pg_ca_file" \
			"$SB_PG_CLIENT_IMAGE" "$@"
	else
		docker run --rm -i --network host -e PGCONNECT_TIMEOUT=15 \
			"$SB_PG_CLIENT_IMAGE" "$@"
	fi
}

# Dumps are every account's whole financial history in one file. 0077 makes the
# directory and every file in it readable by root alone, and it is set before
# anything is created rather than fixed afterward.
umask 077

mkdir -p "$SB_BACKUP_DIR"

# Sorts chronologically as text, which is what lets the pruning at the bottom
# use `sort` instead of a GNU-only `find -printf`. UTC so it keeps sorting
# across a daylight saving change.
stamp=$(date -u +%Y%m%dT%H%M%SZ)
final="$SB_BACKUP_DIR/simple-balance-$stamp.dump"
partial="$final.partial"

# -T, and it is not optional: without it Compose allocates a TTY, and the
# terminal translation corrupts the binary stream on its way to the file. The
# result looks like a dump, has a plausible size, and fails to restore.
#
# -Fc is PostgreSQL's own compressed format. It restores with pg_restore, it can
# be restored selectively, and unlike plain SQL it can be checked without being
# applied — which is what the verification below does.
#
# Redirected to .partial so an interrupted dump is never mistaken for a finished
# one by the pruning below or by whoever reaches for the newest file at 3am.
if [ "$database_in_project" = yes ]; then
	pg pg_dump -U simple_balance -d simple_balance -Fc --no-owner --no-privileges >"$partial"
else
	pg pg_dump -d "$pg_url" -Fc --no-owner --no-privileges >"$partial"
fi

# A dump nobody has read is a hope. pg_restore --list parses the archive's table
# of contents without touching a database, so it catches a truncated file, a
# corrupted stream and an empty one for the price of reading the header.
if ! pg_restore_out=$(pg pg_restore --list <"$partial" 2>&1); then
	rm -f "$partial"
	echo "simple-balance-backup: the dump did not verify and was discarded" >&2
	echo "$pg_restore_out" >&2
	exit 1
fi

# And that it contains something. An archive with a valid header and no tables
# verifies happily, which is what a dump of the wrong database looks like.
entries=$(printf '%s\n' "$pg_restore_out" | grep -c 'TABLE DATA' || true)
if [ "$entries" -lt 1 ]; then
	rm -f "$partial"
	echo "simple-balance-backup: the dump verified but holds no table data" >&2
	exit 1
fi

mv "$partial" "$final"
echo "simple-balance-backup: wrote $final ($(wc -c <"$final" | tr -d " ") bytes, $entries tables)"

# Keep the newest SB_BACKUP_KEEP and remove the rest.
#
# A glob rather than `ls` piped into anything. The timestamp is in the name, so
# the shell's own expansion is already oldest-first and the ones to remove are
# the leading few — which needs no `sort`, no GNU-only `find -printf`, and no
# parsing of `ls` output, whose one job is to be read by people. The `.partial`
# suffix is outside this pattern, so an interrupted dump cannot push a good
# backup off the end.
set -- "$SB_BACKUP_DIR"/simple-balance-*.dump
# An unmatched glob expands to itself in POSIX sh, so the first entry has to be
# a real file before the count below means anything.
[ -f "$1" ] || set --

surplus=$(($# - SB_BACKUP_KEEP))
while [ "$surplus" -gt 0 ]; do
	rm -f "$1"
	echo "simple-balance-backup: pruned ${1##*/}"
	shift
	surplus=$((surplus - 1))
done
