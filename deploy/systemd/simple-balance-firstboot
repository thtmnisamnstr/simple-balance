#!/bin/sh
# Turns a bare Ubuntu into a `single` deployment. Run once per instance by
# cloud-init, and written to be safe to run again: a rebuilt machine is a new
# instance and runs all of this a second time against a data volume that
# already holds its secret, its settings and its backups. The database is not
# on it, or on this machine at all: it is whatever DATABASE_URL names.
#
# Not a systemd unit, deliberately. It is provisioning rather than lifecycle,
# and a unit is a thing that can be enabled and then run at a moment nobody
# chose — which for a script that formats a disk is the wrong shape entirely.
set -eu

# Every path and number this needs, in the one file the units also read. Safe
# to source: every value is a path, a device name or a whole number, and none
# contains a space, a quote or a shell metacharacter.
set -a
# shellcheck disable=SC1091  # written by cloud-init, absent at lint time
. /etc/default/simple-balance
set +a

: "${SB_DATA_DEVICE:?/etc/default/simple-balance did not set SB_DATA_DEVICE}"
: "${SB_BACKUP_DIR:=/var/lib/simple-balance/backups}"

# Wait for the volume to be attached. On both clouds the instance can boot
# before the block device appears, and a mount that races it writes the secret,
# env.local and every backup onto the boot disk — which works, until the machine
# is rebuilt and all three go with the disk.
i=0
while [ ! -b "$SB_DATA_DEVICE" ] && [ "$i" -lt 60 ]; do
	i=$((i + 1))
	sleep 2
done
if [ ! -b "$SB_DATA_DEVICE" ]; then
	echo "simple-balance: the data volume $SB_DATA_DEVICE never appeared" >&2
	exit 1
fi

# Format only if it is not already a filesystem. This one line decides whether
# rebuilding the machine keeps the secret that signs everybody's sessions, the
# settings added by hand and the backups, or erases them.
if ! blkid "$SB_DATA_DEVICE" >/dev/null 2>&1; then
	mkfs.ext4 -L simple-balance "$SB_DATA_DEVICE"
fi

mkdir -p /var/lib/simple-balance
# By label rather than by device name, because the name is the one thing that
# is not stable: it depends on attachment order on one cloud and on a udev rule
# on the other. `nofail` so a machine whose volume is missing still boots far
# enough to be logged into and asked why.
grep -q " /var/lib/simple-balance " /etc/fstab ||
	echo "LABEL=simple-balance /var/lib/simple-balance ext4 defaults,noatime,nofail 0 2" >>/etc/fstab
mountpoint -q /var/lib/simple-balance || mount /var/lib/simple-balance

mkdir -p "$SB_BACKUP_DIR"
chmod 0700 "$SB_BACKUP_DIR"

# Generated here, kept on the data volume, and sent nowhere. The value is of no
# use off this machine, so it belongs neither in user data — readable by anyone
# who can describe the instance — nor in a Pulumi state file. A rebuilt instance
# reattaching the same volume finds the same one, which is what stops a rebuild
# signing everybody out.
secrets=/var/lib/simple-balance/secrets.env
if [ ! -f "$secrets" ]; then
	umask 077
	{
		# tr deletes the newlines openssl wraps at, and the three base64
		# characters that would need escaping in a URL or a compose file.
		#
		# One value, not two. There was a POSTGRES_PASSWORD here while this
		# profile bundled a database; it does not, so generating one produced a
		# password for a server that does not exist and a plausible-looking
		# secret nobody could use.
		echo "AUTH_SECRET=$(openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48)"
	} >"$secrets"
	chmod 0600 "$secrets"
fi

# On the data volume, not beside the compose files. /opt is the boot disk, which
# a rebuild destroys — so an SMTP password or a Stripe key put there would
# survive exactly until the machine was rebuilt, and then vanish with no error
# and no mention of itself.
local_env=/var/lib/simple-balance/env.local
[ -f "$local_env" ] || : >"$local_env"
chmod 0600 "$local_env"

# Rebuilt from the three parts every time this runs, by the same script the
# unit's drop-in runs before every start, so there is one fold rather than a
# copy here that a restart would not use. Run here as well because the question
# below is asked of the assembled file.
/usr/local/sbin/simple-balance-env

systemctl daemon-reload
systemctl enable --now docker

# The one setting this profile cannot generate, because it is the address of
# something somebody else runs.
#
# It is deliberately not a Pulumi setting. A connection string carries a
# password, and anything a Pulumi program puts on the machine arrives as
# cloud-init user data — readable by anyone who can describe the instance, and
# on both clouds that is a wider set of people than it sounds. So it goes in
# env.local, on the data volume, by hand, exactly as an SMTP password or a
# Stripe key does.
#
# Without it the deployment cannot start, and the interesting question is what
# should happen at that point. Starting anyway gives a failed unit and a
# cloud-init error, which reads as a broken image rather than a step nobody has
# taken yet. So the unit is enabled and not started, the reason is written where
# somebody will find it, and this script says so and exits successfully — it is
# safe to run again, which is what makes that a real instruction.
if ! grep -q '^DATABASE_URL=..*' /opt/simple-balance/.env; then
	systemctl enable simple-balance.service
	systemctl enable simple-balance-backup.timer
	cat >/etc/motd <<'MOTD'

Simple Balance is installed and not yet running: it has no database to talk to.

This is the `single` profile, whose database is somebody else's — a managed
PostgreSQL, or a server you already keep. Point it at one:

  sudo nano /var/lib/simple-balance/env.local
      DATABASE_URL='postgresql://user:password@host:5432/simple_balance?sslmode=no-verify'

  sudo /usr/local/sbin/simple-balance-firstboot

Single quotes, so nothing in the value is expanded, and any @ : / ? # % & or $
in the password written as %40 %3A %2F %3F %23 %25 %26 %24. Which sslmode to use
is in docs/deployment.md, "Reaching the database over a network".

That second command rebuilds the configuration and starts the deployment and its
nightly backup. It is the same script that ran at boot and is safe to run again.
Once the deployment is running, a change to env.local takes effect with
sudo systemctl restart simple-balance.

env.local is on the data volume, so what you put there survives the machine
being rebuilt or resized.

MOTD
	echo "simple-balance: no DATABASE_URL yet; enabled but not started. See /etc/motd." >&2
	exit 0
fi

# Started only once there is something to start. A machine that got its
# DATABASE_URL on the second run reaches here on the second run.
#
# restart rather than `enable --now`, which is a start, and a start does nothing
# to a oneshot unit that is already active: run by hand on a live machine to
# apply a setting, this rebuilt .env and left the containers on the old one. A
# restart starts a unit that is not running, so a first boot is the same.
: >/etc/motd
systemctl enable simple-balance.service simple-balance-backup.timer
systemctl restart simple-balance.service
systemctl start simple-balance-backup.timer
