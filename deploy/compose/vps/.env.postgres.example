# The database machine. Copy to .env beside compose.postgres.yml.
#
#   cp .env.postgres.example .env

# This machine's address on the provider's private network. PostgreSQL is
# published here and nowhere else, so getting this wrong either stops the
# application machines reaching it or — with 0.0.0.0 — publishes the ledger to
# whatever the provider's firewall has not closed.
SB_BIND_ADDRESS=10.0.0.5

# Letters and digits, so nothing needs percent-encoding in the connection string
# the application machines carry. Generate one with:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-32
POSTGRES_PASSWORD=

# The five numbers docs/deployment-sizing.md sets out per machine size. These
# defaults are its smallest row. Raise them together with the machine.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_MAX_WAL_SIZE=2GB

# Two application processes at DATABASE_POOL_SIZE 10, plus one each while they
# start, plus room for a person with psql and for the nightly backup.
POSTGRES_MAX_CONNECTIONS=50
