# Both application machines — the API and the scheduler — use this same file.
# Copy it to .env beside compose.app.yml on each, and change SB_BIND_ADDRESS.
#
#   cp .env.app.example .env
#
# Which half runs is decided by COMPOSE_PROFILES in /etc/default/simple-balance,
# not here, so the two machines can hold byte-identical configuration.

# This machine's own address on the private network. The API publishes port 3000
# here; the scheduler publishes nothing and ignores it.
SB_BIND_ADDRESS=10.0.0.6

# The database machine's private address, with the password from its .env.
DATABASE_URL=postgresql://simple_balance:PASSWORD@10.0.0.5:5432/simple_balance

# The public origin the browser reaches — the frontend machine's name, not this
# machine's address. Cookies and the Origin check both depend on it.
APP_BASE_URL=https://books.example.org

# openssl rand -base64 32. The same value on both application machines: sessions
# are signed with it, so two machines with two secrets sign each other out.
AUTH_SECRET=

# Who may create an account. Optional, and it decides only sign-up: leave it
# empty and the first visitor claims the deployment with the setup code from the
# API machine's log.
ALLOWED_EMAILS=

# Mail is optional and everything needing it degrades rather than breaks. With no
# host there is no password reset, nobody is asked to confirm an address, and no
# reminder is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Monetization, off unless set. docs/monetization.md has the table.
SB_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_YEARLY_ID=
ADSENSE_CLIENT_ID=
ADSENSE_BANNER_SLOT_ID=
ADSENSE_FOOTER_SLOT_ID=
