# Both application machines — the API and the scheduler — use this same file.
# Copy it to .env beside compose.app.yml on each, and change SB_BIND_ADDRESS.
#
#   cp .env.app.example .env
#
# Which half runs is decided by COMPOSE_PROFILES in /etc/default/simple-balance,
# not here, so the two machines can hold byte-identical configuration.
#
# Optional settings are commented out, so uncommenting a line is the act that
# turns one on and the file shows at a glance what has been changed. Only the
# secret is present and empty, because a secret has no example value that is not
# a hazard.

# This machine's own address on the private network. The API publishes port 3000
# here; the scheduler publishes nothing and ignores it.
SB_BIND_ADDRESS=10.0.0.6

# The database machine's private address, with the password from its .env.
DATABASE_URL=postgresql://simple_balance:PASSWORD@10.0.0.5:5432/simple_balance

# Only when a transaction pooler such as PgBouncer sits in front of the
# database, which this profile does not ship. Migrations and the first-account
# claim hold a session-level advisory lock that a pooler cannot carry, so they
# connect here instead.
# DIRECT_DATABASE_URL=postgresql://simple_balance:PASSWORD@10.0.0.5:5432/simple_balance

# The public origin the browser reaches — the frontend machine's name, not this
# machine's address. Cookies and the Origin check both depend on it.
APP_BASE_URL=https://books.example.org

# openssl rand -base64 32. The same value on both application machines: sessions
# are signed with it, so two machines with two secrets sign each other out.
AUTH_SECRET=

# local, google, or both. Google needs GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# and an ALLOWED_EMAILS that admits somebody.
# AUTH_MODE=local

# Who may register, comma separated: addresses (you@example.com), domains
# (example.com or @example.com), or * for anybody. It decides only sign-up. Left
# commented out it admits nobody but the first account, which is claimed with
# the setup code below.
# ALLOWED_EMAILS=you@example.com

# The one-time code that claims the first account. Left commented out, the API
# machine generates one and prints it to its log while no account exists. At
# least 16 characters if you set it.
# SETUP_TOKEN=replace-with-a-long-random-first-run-code

# Only when AUTH_MODE is google or both.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# debug, info, warn, or error.
# LOG_LEVEL=info

# A mail server. Set SMTP_HOST and MAIL_FROM together and three things switch
# on: forgotten-password resets, address confirmation for a new account, and the
# scheduled reminders, which the scheduler machine sends. Set one without the
# other and neither machine starts. Leave the block alone and none of it
# happens: mail is optional and everything needing it degrades rather than
# breaks.
# SMTP_HOST=smtp.example.com
# MAIL_FROM=Simple Balance <balance@example.com>
# MAIL_REPLY_TO=Simple Balance <support@example.com>
# 465 expects a connection encrypted from the first byte, which is SMTP_SSL
# true. False starts on 587 and upgrades with STARTTLS.
# SMTP_PORT=587
# SMTP_SSL=false
# Set both or neither. Compose interpolates this file, so single-quote a
# password containing $ or it is read as a variable name and disappears. Do not
# double-quote it, which interpolates too.
# SMTP_USERNAME=balance@example.com
# SMTP_PASSWORD=an-app-password-not-the-account-password

# The plan tab's content security policy, rehearsed rather than enforced, for
# the hour after turning billing on. Only that page: every other page keeps
# enforcing. Set it on the frontend machine as well, whose nginx serves the page
# and so decides which header it arrives with; this copy registers the endpoint
# the reports land on. Never leave it on.
# SB_CSP_REPORT_ONLY=false

# Charging for a plan; docs/monetization.md has the table. The five Stripe
# settings only mean this deployment can reach Stripe, and SB_BILLING_ENABLED is
# the separate question of whether it sells anything. Both machines reach
# api.stripe.com: the scheduler runs the sweep that repairs a missed webhook.
# Put the publishable key on the frontend machine too. Single-quote any value
# containing $.
# SB_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_replace-with-your-own
# STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-own
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-own
# STRIPE_PRICE_MONTHLY_ID=price_replace-with-your-own
# STRIPE_PRICE_YEARLY_ID=price_replace-with-your-own

# AdSense. A client id and a banner slot go together, and the client id goes on
# the frontend machine too. Ads are shown only where a plan is for sale, with
# SB_BILLING_ENABLED set to true and Stripe configured: a free account then sees
# one banner and a paid account never does. With billing off nobody is on a
# limited plan, so these widen the content security policy on every page and
# serve ads.txt and show nobody an ad.
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# ADSENSE_BANNER_SLOT_ID=0000000000
# ADSENSE_FOOTER_SLOT_ID=0000000000
# Whether ads may be personalized. Off by default: personalized advertising
# profiles the person reading the page, and this page is showing them their own
# money. Turning it on asserts you have a certified consent platform.
# ADSENSE_CONSENT_MANAGED=false
# Required as soon as the AdSense ids are set, and an absolute https:// address.
# Google's program policies require a privacy policy on any site serving their
# ads, so both machines refuse to start without one, and the app links to it
# from every page.
# PRIVACY_POLICY_URL=https://books.example.org/privacy/
