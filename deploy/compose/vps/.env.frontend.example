# The public machine. Copy to .env beside compose.frontend.yml.
#
#   cp .env.frontend.example .env
#
# Optional settings are commented out, so uncommenting a line is the act that
# turns one on.

# The API machine's private address. This is what makes the deployment four
# machines rather than one, and it is plain http:// because the hop is inside the
# private network.
SB_API_ORIGIN=http://10.0.0.6:3000

# The public DNS name, which must already resolve to this machine's public
# address before Let's Encrypt will issue for it. Must match the host in
# APP_BASE_URL on the application machines.
SITE_ADDRESS=books.example.org

# Where Let's Encrypt writes about a certificate it could not renew. Optional to
# them and worth setting: the failure it warns about is a site that stops
# loading.
# ACME_EMAIL=you@example.com

# These two are here only so the frontend serves a Content-Security-Policy that
# matches what the API is actually configured for: nginx serves every page on
# this machine, so it decides which policy each one arrives with. Set them to
# the same values the application machines have, or leave them out on both.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-own
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# The plan tab's policy rehearsed rather than enforced. This copy is the one
# that decides, because nginx serves that page; the application machines' copy
# registers the endpoint the reports land on, so set both or neither. Only the
# plan tab: every other page keeps enforcing. Never leave it on.
# SB_CSP_REPORT_ONLY=false
