# Settings for compose.distributed.yml. Copy this to .env beside it:
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# Compose reads .env from the directory the compose file lives in, so this one
# is separate from the repository root .env that the single container uses.
# Everything else those three containers need is already in the compose file,
# where the split-deployment values can carry the reason they are what they are.

# The password for the PostgreSQL container, and half of the DATABASE_URL the
# compose file builds from it. Pick something with no characters that would need
# percent-encoding in a URL, and no $, which Compose reads as the start of a
# variable name: letters and digits are always safe.
#
# It belongs to the postgres container in this compose file rather than to
# Simple Balance, and it goes away with that service the moment DATABASE_URL
# names a database somebody else runs.
POSTGRES_PASSWORD=

# At least 32 random characters: openssl rand -base64 32
# Sessions are signed with it, so changing it signs everybody out. Startup
# refuses the placeholders published in this project's own files, so there is
# nothing here to leave in place by accident.
AUTH_SECRET=

# The origin you open in a browser, which is the frontend's. Change it and the
# published port in the compose file has to follow.
#
# The images run with NODE_ENV=production, which refuses an APP_BASE_URL that is
# neither HTTPS nor loopback, so reaching this from another machine means
# terminating TLS in front of the frontend and naming that https:// origin here.
APP_BASE_URL=http://localhost:8080

# local, google, or both. Google needs GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# and an ALLOWED_EMAILS that admits somebody.
AUTH_MODE=local

# Who may register, comma separated: addresses (you@example.com), domains
# (example.com or @example.com), or * for anybody. Left commented out it admits
# nobody but the first account, which is what keeps an unconfigured deployment
# private.
# ALLOWED_EMAILS=you@example.com

# The one-time code that claims the first account. Left commented out, the
# server generates one and prints it to its log while no account exists. At
# least 16 characters if you set it, or the server refuses to start.
#
# It is read only after ALLOWED_EMAILS has turned an address away, so a list
# admitting anybody makes it unreachable and none is printed: there is nothing
# to claim when the sign-up form already lets you in.
# SETUP_TOKEN=replace-with-a-long-random-first-run-code

# debug, info, warn, or error.
LOG_LEVEL=info

# Only when AUTH_MODE is google or both.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: a mail server. Set SMTP_HOST and MAIL_FROM together and three
# things switch on: people can reset a forgotten password, a new account has to
# confirm its address before it works, and the scheduled reminders can be
# delivered — a recurrence set to write when it proposes, and a template
# reminder. Leave the block commented out and none of it happens, which is the
# right answer for a deployment of one. Both node services read it, and the
# scheduler is the one that sends. Use a submission service, not the MX host
# your domain publishes.
# SMTP_HOST=smtp.example.com
# MAIL_FROM=Simple Balance <balance@example.com>
# MAIL_REPLY_TO=Simple Balance <support@example.com>
# 465 expects a connection encrypted from the first byte, which is SMTP_SSL
# true. False starts on 587 and upgrades with STARTTLS, which is what nearly
# every provider wants.
# SMTP_PORT=587
# SMTP_SSL=false
# Set both or neither. A password is never sent unencrypted: with SMTP_SSL false
# and credentials set, the STARTTLS upgrade is required rather than attempted.
#
# Compose interpolates this file, so single-quote a password containing $ or it
# is read as a variable name and disappears. Do not double-quote it, which
# interpolates too. The root .env.example says the opposite for the same
# password, because `docker run --env-file` reads that one and passes the value
# through as typed: the rule belongs to the parser, not to the password.
# SMTP_USERNAME=balance@example.com
# SMTP_PASSWORD=an-app-password-not-the-account-password

# How long a used idempotency key keeps replaying, in hours. Zero, unset or
# empty all mean forever, which is what every release before 0.1.6 did. Every
# create, commit and bulk write stores a copy of its response so a retried
# request answers the same way twice; nothing prunes those copies unless you set
# this. A window is safe because the record makes a retry quiet rather than
# safe: a repeated create still meets the duplicate check, and a repeated bulk
# write still carries a count and fingerprint that no longer match.
# IDEMPOTENCY_RETENTION_HOURS=0

# Which addresses the frontend's nginx will believe about where a request came
# from. Nothing sits in front of it in this recipe, so the default changes
# nothing and loopback is the off position.
#
# The moment you put a TLS terminator in front — which is what reaching this
# from another machine means — set this to that terminator's address or range,
# or the API counts every sign-in attempt in the deployment against that one
# address and four wrong passwords lock everybody out. The terminator's own
# range, never the visitors': this decides whose word is taken for an address.
# SB_TRUSTED_PROXY_CIDR=127.0.0.1

# The plan tab's content security policy, rehearsed rather than enforced.
# Turning this on makes the browser report what that one page's policy would
# have blocked and block nothing there, and registers POST /api/csp-report for
# the reports to arrive at. It is for the hour after turning billing on: the
# plan tab loads Stripe's payment form, and Stripe publishes only part of the
# host list it actually reaches.
#
# Only the plan tab. Every other page keeps enforcing, so this reports nothing
# about AdSense, which never renders there: an ad the policy refuses shows up as
# a violation in the browser console on the page that carries it.
#
# Never leave it on. While it is true the plan and billing tab blocks nothing,
# and the process says so at startup every time.
# SB_CSP_REPORT_ONLY=false

# Prometheus metrics, off unless asked for. Turning this on makes both the
# server and the scheduler answer GET /metrics on their own container port,
# which this file does not publish to the host and the frontend does not proxy.
# A scraper therefore has to be on this compose network, which is why the token
# below is optional here.
# METRICS_ENABLED=false
# METRICS_TOKEN=

# Optional: charging for a plan. The five Stripe settings go together and only
# mean this deployment can reach Stripe; SB_BILLING_ENABLED is the separate
# question of whether it sells anything. Set it and a free account is held to
# three financial accounts; leave it and nobody is limited. Two settings rather
# than one because a deployment winding down stops selling long before it stops
# listening to the subscriptions people are still paying for.
#
# Compose interpolates this file, so single-quote any value containing $. The
# webhook secret is the one most likely to.
# SB_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_replace-with-your-own
# STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-own
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-own
# STRIPE_PRICE_MONTHLY_ID=price_replace-with-your-own
# STRIPE_PRICE_YEARLY_ID=price_replace-with-your-own

# Optional: AdSense. A client id and a banner slot go together. It widens the
# browser's content security policy on every page that shows your balances,
# because AdSense publishes no list of the hosts it loads from. Unset, the
# policy stays default-src 'self'. The footer unit is off unless you add it.
#
# Ads are shown only where a plan is for sale, with SB_BILLING_ENABLED set to
# true and Stripe configured above: a free account then sees one banner and a
# paid account never does. With billing off nobody is on a limited plan, so
# these widen the policy and serve ads.txt and show nobody an ad.
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# ADSENSE_BANNER_SLOT_ID=0000000000
# ADSENSE_FOOTER_SLOT_ID=0000000000
# Whether ads may be personalized. Off by default, and that is the whole point:
# personalized advertising profiles the person reading the page, and this page is
# showing them their own money. Turning it on asserts you have a certified
# consent platform — Google requires one for EEA and UK traffic, and cookie
# consent is needed there even for non-personalized ads. Nothing here can check
# the claim, so the default is the safe answer rather than the profitable one.
# ADSENSE_CONSENT_MANAGED=false
# Required as soon as the AdSense ids are set, and an absolute https:// address.
# Google's program policies require a privacy policy on any site serving their
# ads, so the server and the scheduler both refuse to start without one, and
# the app links to it from every page.
# PRIVACY_POLICY_URL=https://books.example.com/privacy/
