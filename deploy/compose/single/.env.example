# Settings for the `single` profile. Copy this to .env beside it:
#
#   cp deploy/compose/single/.env.example deploy/compose/single/.env
#
# Compose reads .env from the directory the compose file lives in, so this one
# is separate from ../.env, which belongs to the split recipe, and from the
# repository root .env, which the bare `docker run` in docs/deployment.md uses.
#
# Everything with a sensible default lives in the compose file rather than here,
# where the value can carry the reason it is what it is. What is left in this
# file is what a deployment has to decide for itself.

# ---------------------------------------------------------------- required ---

# The password for the PostgreSQL container. Letters and digits only: anything
# needing percent-encoding breaks the connection string the compose file builds,
# and a $ is read by Compose as the start of a variable name.
POSTGRES_PASSWORD=

# At least 32 random characters: openssl rand -base64 32
# Sessions are signed with it, so changing it signs everybody out. Startup
# refuses the placeholders published in this project's own files.
AUTH_SECRET=

# The origin people open in a browser. This value is what the session cookies
# belong to and what every state-changing request's Origin is compared against,
# so it has to be the address in the address bar and not this container's port.
#
# Plain HTTP is legal only on loopback, because the image runs with
# NODE_ENV=production. The moment this machine is reachable from anywhere else,
# this becomes https://books.example.com and something terminates TLS —
# compose.caddy.yml is the batteries-included answer.
APP_BASE_URL=http://localhost:3000

# local, google, or both. Google needs GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# and an ALLOWED_EMAILS that admits somebody.
AUTH_MODE=local

# debug, info, warn, or error.
LOG_LEVEL=info

# ------------------------------------------------------ TLS, with Caddy ---
# Only read by compose.caddy.yml. Ignore this block if something else
# terminates TLS, and set TRUST_PROXY=true below instead.

# The public name Caddy answers on and obtains a certificate for. It must be the
# host in APP_BASE_URL, and it must already resolve to this machine — Let's
# Encrypt proves the name by connecting to it.
#
# A bare hostname gets automatic HTTPS. Write `:80` instead and Caddy serves
# plain HTTP and asks for no certificate, which is the way to try the overlay
# on a machine with no public name.
SITE_ADDRESS=

# Where Let's Encrypt writes about a renewal that failed. Optional to them, and
# worth setting: the thing it warns you about is a site that stops loading.
# ACME_EMAIL=you@example.com

# The largest request body Caddy will pass through, matching the ceiling the
# application enforces for a CSV import. Lower it and large imports are refused
# a hop earlier than the message explaining the limit.
#
# MiB, not MB: Caddy reads MB as a million, and the application's limit is
# CSV_MAX_BYTES x 6 + 64 KiB, which is binary. 61MB is under it and 61MiB is
# not.
# MAX_BODY_SIZE=61MiB

# --------------------------------------------------------------- the host ---

# Where the database's files live. This should be the data disk rather than the
# boot disk: a PostgreSQL that fills the boot disk takes the whole machine with
# it, and docs/deployment-sizing.md sizes the two separately. The systemd unit
# in deploy/systemd/ creates this directory before starting anything.
# POSTGRES_DATA_DIR=/var/lib/simple-balance/postgres

# Where the application's port is published on the host. Loopback, unless
# something on another machine has to reach it directly — and then the thing
# reaching it is terminating TLS, so it is the port that should move rather than
# the address.
# APP_BIND_ADDRESS=127.0.0.1
# APP_PORT=3000

# Whether to believe X-Forwarded-For. compose.caddy.yml sets this to true for
# you. Set it yourself if you run your own terminator — and only then: with
# nothing in front, a caller writes their own address into the header and gets
# as many sign-in attempts as they care to ask for.
# TRUST_PROXY=false

# Pin these for a deployment you upgrade deliberately. Left alone they follow
# the major version, which picks up patch releases on `docker compose pull`.
#
# Stay on a Debian-based PostgreSQL. The Alpine images are musl, which compares
# text byte by byte however the collation is declared, so every category, payee
# and account list comes back with capitals first and accents at the end. The
# compose file has the measurement.
# POSTGRES_IMAGE=postgres:16
# CADDY_IMAGE=caddy:2-alpine

# ------------------------------------------------------ database sizing ---
# The defaults are for the 2 vCPU / 4 GiB baseline. docs/deployment-sizing.md
# has the table for every other size, and explains which of these matter.

# POSTGRES_SHARED_BUFFERS=512MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAINTENANCE_WORK_MEM=256MB
# POSTGRES_MAX_CONNECTIONS=100
# POSTGRES_MAX_WAL_SIZE=4GB
# Both of these describe an SSD, which is what the defaults assume. Raise
# random_page_cost towards 4.0 only for spinning disks.
# POSTGRES_RANDOM_PAGE_COST=1.1
# POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
# Statements slower than this are logged, in milliseconds. 0 logs everything,
# which on a busy deployment is a way to fill a disk.
# POSTGRES_LOG_MIN_DURATION_MS=1000

# How many database connections the application holds. One process, so the
# deployment opens this plus one. There is nothing to scale out in this profile,
# so this is the whole budget.
# DATABASE_POOL_SIZE=10

# ------------------------------------------------------------- optional ---

# Who may register, comma separated: addresses (you@example.com), domains
# (example.com or @example.com), or * for anybody. Left commented out it admits
# nobody but the first account, which is what keeps an unconfigured deployment
# private.
# ALLOWED_EMAILS=you@example.com

# The one-time code that claims the first account. Left commented out, the
# server generates one and prints it to its log while no account exists. At
# least 16 characters if you set it.
# SETUP_TOKEN=replace-with-a-long-random-first-run-code

# Only when AUTH_MODE is google or both.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# A mail server. Set SMTP_HOST and MAIL_FROM together and three things switch
# on: forgotten-password resets, address confirmation for a new account, and the
# scheduled reminders. Leave the block alone and none of it happens, which is
# the right answer for a deployment of one.
# SMTP_HOST=smtp.example.com
# MAIL_FROM=Simple Balance <balance@example.com>
# MAIL_REPLY_TO=Simple Balance <support@example.com>
# 465 expects a connection encrypted from the first byte, which is SMTP_SSL
# true. False starts on 587 and upgrades with STARTTLS.
# SMTP_PORT=587
# SMTP_SSL=false
# Set both or neither. Compose interpolates this file, so single-quote a
# password containing $ or it is read as a variable name and disappears. Do not
# double-quote it, which interpolates too.
# SMTP_USERNAME=balance@example.com
# SMTP_PASSWORD=an-app-password-not-the-account-password

# How long a used idempotency key keeps replaying, in hours. Zero, unset or
# empty all mean forever.
# IDEMPOTENCY_RETENTION_HOURS=0

# Prometheus metrics. Nothing publishes the port and Caddy does not proxy
# /metrics, so a scraper has to be on the compose network.
# METRICS_ENABLED=false
# METRICS_TOKEN=

# The content security policy, rehearsed rather than enforced. For the hour
# after turning billing on, and never left on.
# SB_CSP_REPORT_ONLY=false

# Charging for a plan. The five Stripe settings only mean this deployment can
# reach Stripe; SB_BILLING_ENABLED is the separate question of whether it sells
# anything. Single-quote any value containing $.
# SB_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_replace-with-your-own
# STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-own
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-own
# STRIPE_PRICE_MONTHLY_ID=price_replace-with-your-own
# STRIPE_PRICE_YEARLY_ID=price_replace-with-your-own

# AdSense. A client id and a banner slot go together; a free account then sees
# one banner and a paid account never does. It widens the browser's content
# security policy on every page that shows your balances.
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# ADSENSE_BANNER_SLOT_ID=0000000000
# ADSENSE_FOOTER_SLOT_ID=0000000000
# Whether ads may be personalised. Off by default: personalised advertising
# profiles the person reading the page, and this page is showing them their own
# money. Turning it on asserts you have a certified consent platform.
# ADSENSE_CONSENT_MANAGED=false
