# Settings for the `single` profile. Copy this to .env beside it:
#
#   install -m 0600 deploy/compose/single/.env.example deploy/compose/single/.env
#
# Compose reads .env from the directory the compose file lives in, so this one
# is separate from ../.env, which belongs to the split recipe, and from the
# repository root .env, which the bare `docker run` in docs/deployment.md uses.
#
# Everything with a sensible default lives in the compose file rather than here,
# where the value can carry the reason it is what it is. What is left in this
# file is what a deployment has to decide for itself.

# ---------------------------------------------------------------- required ---

# Where the database is. This machine does not run one: point this at the
# database machine beside it, which compose.postgres.yml in this directory runs,
# or at a managed PostgreSQL, or at a server you already keep awake.
#
# Losing this machine should lose no data, which is the whole point of the
# profile — so the database must not be on it. On the pair deploy/pulumi builds
# this line is written for you, and the database node it names is reachable from
# this machine and from nothing else.
#
# Anything that crosses a network should be encrypted, and checked: without the
# check, whoever answers at that address gets the password. Save the CA
# certificate that signed the database's as
# /var/lib/simple-balance/tls/db-ca.pem, name it, and run compose.db-tls.yml
# beside compose.yml — that overlay mounts the directory into the application,
# and the nightly backup mounts the file into its client:
#
#   DATABASE_URL=postgresql://user:password@db.example.com:5432/simple_balance?sslmode=verify-full&sslrootcert=/var/lib/simple-balance/tls/db-ca.pem
#
# The host has to be a name the certificate carries, not the server's IP
# address. A certificate from a public CA needs no file: leave out the
# &sslrootcert=... part. README.md, "The database's certificate", says where the
# file comes from, OCI Database with PostgreSQL's and Amazon RDS's included.
#
# sslmode=no-verify still works, and encrypts without checking. Not require,
# which node-postgres reads as verify-full without the file, so it fails
# against exactly the certificate it is usually chosen for.
DATABASE_URL=

# Only when a transaction pooler such as PgBouncer sits in front of that
# database, which managed services often hand out as the default endpoint.
# Migrations and the first-account claim hold a session-level advisory lock
# that a pooler cannot carry, so they connect here instead.
# DIRECT_DATABASE_URL=postgresql://user:password@direct.example.com:5432/simple_balance

# At least 32 random characters: openssl rand -base64 32
# Sessions are signed with it, so changing it signs everybody out. Startup
# refuses the placeholders published in this project's own files.
AUTH_SECRET=

# The origin people open in a browser. This value is what the session cookies
# belong to and what every state-changing request's Origin is compared against,
# so it has to be the address in the address bar and not this container's port.
#
# Plain HTTP is legal only on loopback, because the image runs with
# NODE_ENV=production. The moment this machine is reachable from anywhere else,
# this becomes https://books.example.com and something terminates TLS —
# compose.caddy.yml is the batteries-included answer.
APP_BASE_URL=http://localhost:3000

# local, google, or both. Google needs GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# and an ALLOWED_EMAILS that admits somebody.
AUTH_MODE=local

# debug, info, warn, or error.
LOG_LEVEL=info

# ------------------------------------------------------ TLS, with Caddy ---
# Only read by compose.caddy.yml. Ignore this block if something else
# terminates TLS, and set TRUST_PROXY=true below instead.

# The public name Caddy answers on and obtains a certificate for. It must be the
# host in APP_BASE_URL, and it must already resolve to this machine — Let's
# Encrypt proves the name by connecting to it.
#
# A bare hostname gets automatic HTTPS. Write `:80` instead and Caddy serves
# plain HTTP and asks for no certificate, which is the way to try the overlay
# on a machine with no public name.
SITE_ADDRESS=

# Where Let's Encrypt writes about a renewal that failed. Optional to them, and
# worth setting: the thing it warns you about is a site that stops loading.
# ACME_EMAIL=you@example.com

# The largest request body Caddy will pass through, matching the ceiling the
# application enforces for a CSV import. Lower it and large imports are refused
# a hop earlier than the message explaining the limit.
#
# MiB, not MB: Caddy reads MB as a million, and the application's limit is
# CSV_MAX_BYTES x 6 + 64 KiB, which is binary. 61MB is under it and 61MiB is
# not.
# MAX_BODY_SIZE=61MiB

# --------------------------------------------------------------- the host ---

# Where the application's port is published on the host. Loopback, unless
# something on another machine has to reach it directly — and then the thing
# reaching it is terminating TLS, so it is the port that should move rather than
# the address.
# APP_BIND_ADDRESS=127.0.0.1
# APP_PORT=3000

# Whether to believe X-Forwarded-For. compose.caddy.yml sets this to true for
# you. Set it yourself if you run your own terminator — and only then: with
# nothing in front, a caller writes their own address into the header and gets
# as many sign-in attempts as they care to ask for.
# TRUST_PROXY=false

# Caddy's image. Pin it for a deployment you upgrade deliberately: left alone it
# follows the major version, which picks up patch releases on
# `docker compose pull`. Only compose.caddy.yml reads it, so it does nothing
# without that overlay.
# CADDY_IMAGE=caddy:2-alpine

# --------------------------------------------------------- the database ---

# How many connections the application holds. One process, so the deployment
# opens this plus one. docs/capacity.md measured the pool as the first thing
# that runs out under concurrency: ten simultaneous CSV imports hold all ten and
# everything else waits. Raise it if several people import at once.
# DATABASE_POOL_SIZE=10

# Tuning the server itself is the server's business in this profile.
# docs/deployment-sizing.md has the table if it is a machine you control.

# ------------------------------------------------------------- optional ---

# Who may register, comma separated: addresses (you@example.com), domains
# (example.com or @example.com), or * for anybody. Left commented out it admits
# nobody but the first account, which is what keeps an unconfigured deployment
# private.
# ALLOWED_EMAILS=you@example.com

# The one-time code that claims the first account. Left commented out, the
# server generates one and prints it to its log while no account exists. At
# least 16 characters if you set it.
# SETUP_TOKEN=replace-with-a-long-random-first-run-code

# Only when AUTH_MODE is google or both.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# A mail server. Set SMTP_HOST and MAIL_FROM together and three things switch
# on: forgotten-password resets, address confirmation for a new account, and the
# scheduled reminders. Leave the block alone and none of it happens, which is
# the right answer for a deployment of one.
# SMTP_HOST=smtp.example.com
# MAIL_FROM=Simple Balance <balance@example.com>
# MAIL_REPLY_TO=Simple Balance <support@example.com>
# 465 expects a connection encrypted from the first byte, which is SMTP_SSL
# true. False starts on 587 and upgrades with STARTTLS.
# SMTP_PORT=587
# SMTP_SSL=false
# Set both or neither. Compose interpolates this file, so single-quote a
# password containing $ or it is read as a variable name and disappears. Do not
# double-quote it, which interpolates too.
# SMTP_USERNAME=balance@example.com
# SMTP_PASSWORD=an-app-password-not-the-account-password

# How long a used idempotency key keeps replaying, in hours. Zero, unset or
# empty all mean forever.
# IDEMPOTENCY_RETENTION_HOURS=0

# ---------------------------------------------------------------- metrics ---
# The application's figures and this machine's, scraped by a collector that
# compose.yml runs beside it and sent to one backend. Off unless asked for.
# Caddy refuses /metrics whatever is set here, so the numbers never leave by
# the site's own address.
#
# Three lines turn it on, and they go together. COMPOSE_PROFILES starts the
# collector and node-exporter, which compose.yml runs only under that
# profile; METRICS_ENABLED opens the endpoint the collector reads; and
# SB_METRICS_EXPORT_ENDPOINT says where it all goes. Compose cannot work the
# first two out from the third, and with METRICS_ENABLED left off the
# collector sends this machine's figures and none of the application's,
# saying so only in its own log. A machine a cloud program built does derive
# them, so a stack sets the endpoint alone.
#
# To turn it off again, `docker compose --profile metrics down` first: a
# `down` that does not name the profile leaves its containers running.
# COMPOSE_PROFILES=metrics
# METRICS_ENABLED=true
# SB_METRICS_EXPORT_ENDPOINT=https://otlp.nr-data.net

# otlp, the default, or prometheus_remote_write. OTLP's endpoint is a base
# URL, New Relic's EU one https://otlp.eu01.nr-data.net; remote write's is the
# whole write URL, such as
# https://metric-api.newrelic.com/prometheus/v1/write?prometheus_server=simple-balance
# SB_METRICS_EXPORT_PROTOCOL=otlp

# The backend's credential, as a JSON object of header names to values. New
# Relic's OTLP endpoint takes {"api-key":"<license key>"}, its remote write
# {"Authorization":"Bearer <license key>"}. Leave it out for a backend that
# needs none. Single-quote it: Compose interpolates this file, and a $ in a
# key would be read as a variable and vanish.
# SB_METRICS_EXPORT_HEADERS='{"api-key":"your-ingest-license-key"}'

# How often to scrape, and always under five minutes: New Relic turns a
# counter into a rate by remembering its last value, and forgets one that has
# been silent for five.
# SB_METRICS_SCRAPE_INTERVAL=30s

# The deployment.environment.name every series carries, which is what tells
# two deployments apart in one account.
# SB_METRICS_ENVIRONMENT=production

# The database machine's node-exporter, as host:port, scraped over TLS and
# checked against the CA compose.db-tls.yml mounts, so it needs that overlay.
# The host is one the database's certificate names: the host in
# DATABASE_URL, or the machine's private address. A cloud program sets it for
# a database node it built; leave it out for a managed database.
# SB_METRICS_DATABASE_TARGET=db.internal.example.com:9100

# The bearer token the collector sends and the application checks. Optional
# here: the port is published on loopback and Caddy never forwards the path,
# so only something already on this machine could read it without one.
# METRICS_TOKEN=

# The plan tab's content security policy, rehearsed rather than enforced. For
# the hour after turning billing on, and never left on. Only that page: every
# other page keeps enforcing, so it says nothing about AdSense, which never
# renders on the plan tab.
# SB_CSP_REPORT_ONLY=false

# Charging for a plan. The five Stripe settings only mean this deployment can
# reach Stripe; SB_BILLING_ENABLED is the separate question of whether it sells
# anything. Single-quote any value containing $.
# SB_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_replace-with-your-own
# STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-own
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-own
# STRIPE_PRICE_MONTHLY_ID=price_replace-with-your-own
# STRIPE_PRICE_YEARLY_ID=price_replace-with-your-own

# AdSense. A client id and a banner slot go together. Ads are shown only where a
# plan is for sale, with SB_BILLING_ENABLED set to true and Stripe configured
# above: a free account then sees one banner and a paid account never does.
# With billing off nobody is on a limited plan, so these widen the browser's
# content security policy on every page that shows your balances and serve
# ads.txt, and show nobody an ad.
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# ADSENSE_BANNER_SLOT_ID=0000000000
# ADSENSE_FOOTER_SLOT_ID=0000000000
# Whether ads may be personalized. Off by default: personalized advertising
# profiles the person reading the page, and this page is showing them their own
# money. Turning it on asserts you have a certified consent platform.
# ADSENSE_CONSENT_MANAGED=false
# PRIVACY_POLICY_URL, below, is required beside these.

# This product's own advertisement for the paid plan, shown to a free account
# while a plan is for sale. It loads nothing from any other site, so it needs
# no privacy policy and widens no policy. With the AdSense ids also set, a free
# account sees the house ad and no AdSense unit.
# SB_HOUSE_AD=false

# Optional: where this deployment's privacy policy and terms of use live, each
# an absolute https:// address. Set either and the app links it from the
# sign-in and sign-up screens and from every page; with terms set, the sign-up
# form says that creating an account accepts them, and the plan tab links them
# beside its renewal terms. The privacy policy is required as soon as the
# AdSense ids are set: Google's program policies require one on any site
# serving their ads, so the server refuses to start without it.
# PRIVACY_POLICY_URL=https://books.example.com/privacy/
# TERMS_OF_USE_URL=https://books.example.com/terms/
