# The database machine of the `single` profile. Copy to .env beside
# compose.postgres.yml, on that machine and not on the application one.
#
#   install -m 0600 .env.postgres.example .env
#
# On a machine deploy/pulumi built there is nothing to copy: cloud-init writes
# env.base and env.db, simple-balance-db-firstboot generates the superuser
# password onto the data volume, and simple-balance-env folds the three into
# this same .env before every start. This file is the hand-install path and the
# reference for what that fold produces.

# This machine's address on the provider's private network. PostgreSQL is
# published here and nowhere else, so getting this wrong either stops the
# application machine reaching it or — with 0.0.0.0 — publishes the ledger to
# whatever the provider's firewall has not closed.
SB_BIND_ADDRESS=10.0.0.5

# The superuser. Reached over this container's own socket and refused over the
# network by pg_hba.conf, so its only readers are the entrypoint and anyone who
# already has a shell on this machine.
#
# Letters and digits, so nothing needs percent-encoding anywhere it is written.
# Generate one with:
#   openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
POSTGRES_PASSWORD=

# The unprivileged role the application signs in as, created by db-init.sh on
# the boot that creates the cluster. This is the one that also goes in the
# application machine's DATABASE_URL, so the two have to match; the same
# alphanumeric recipe, for the same reason, plus one more — it ends up inside a
# URL, where an @ or a / would end the password early.
POSTGRES_APP_PASSWORD=

# Where the cluster's files go. It has to be a directory that exists and that
# outlives this machine — a block volume, not the boot disk. compose.postgres.yml
# refuses to start rather than create it, because a directory Docker created is
# on the boot disk and PostgreSQL would initialise a new empty ledger into it and
# report itself healthy.
#SB_PGDATA_DIR=/var/lib/simple-balance/postgresql

# The five numbers docs/deployment-sizing.md sets out per machine size. Left
# commented out because compose.postgres.yml already applies its smallest row,
# and the values below are that row — uncommenting them changes nothing, which
# is the point of writing them out.
#
# Pick the column by the memory of *this* machine, which runs PostgreSQL and
# nothing else. Not by the application machine's: the two are sized separately
# (`simple-balance:databaseSize` against `simple-balance:size`) because they
# want opposite things, and a 4 GiB application node in front of a 16 GiB
# database node is the ordinary case rather than a mismatch. The row that
# matters here is the one this machine's memory names.
#
# Three more — random_page_cost, effective_io_concurrency and wal_compression —
# are not here and not settable, because they describe the disk rather than the
# memory and are the same on every size. compose.postgres.yml passes them as
# literals and says why.
#POSTGRES_SHARED_BUFFERS=512MB
#POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
#POSTGRES_WORK_MEM=8MB
#POSTGRES_MAINTENANCE_WORK_MEM=256MB
#POSTGRES_MAX_WAL_SIZE=4GB

# One application process at DATABASE_POOL_SIZE 10, plus one while it starts,
# plus room for a person with psql and for the nightly backup, is eleven of
# these fifty. Each connection costs memory that shared_buffers would rather
# have, which is why this is not the default of 100.
#POSTGRES_MAX_CONNECTIONS=50

# Metrics. Uncommented, this starts node-exporter beside PostgreSQL, which the
# application machine's collector scrapes for this machine's CPU, memory, load,
# disks and the space left on the data volume. It listens on SB_BIND_ADDRESS,
# port 9100, and nowhere else, and it serves TLS with the database's own
# certificate, so the collector checks it against the CA it already trusts.
#
# Three things first. Without either of the first two `up` refuses and names
# the path; without the third nothing refuses at all:
#   - its own copy of the certificate and key, owned by the uid it runs as:
#       sudo install -d -m 0700 -o 61000 -g 61000 node-exporter-tls
#       sudo install -m 0644 db-tls/server.crt node-exporter-tls/server.crt
#       sudo install -m 0600 -o 61000 -g 61000 db-tls/server.key node-exporter-tls/server.key
#     (a copy, because PostgreSQL's key cannot be shared without loosening it;
#     simple-balance-db-firstboot makes this on a machine deploy/pulumi built);
#   - node-exporter-web.yml beside compose.postgres.yml, which it reads;
#   - 9100/tcp open from the application machine, and only from it, in
#     whatever firewall sits in front of this machine, or everything here
#     starts healthy and the collector's scrapes time out.
# On the application machine, SB_METRICS_DATABASE_TARGET names this one.
#
# Turning it off again is `docker compose rm --stop --force node-exporter`,
# then the line commented out. Not a `down`: that stops PostgreSQL with it, and
# one that does not name the profile leaves node-exporter running anyway.
#COMPOSE_PROFILES=metrics
