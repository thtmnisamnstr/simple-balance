# Rendered at container start by the nginx image's entrypoint, which runs
# envsubst over every template in /etc/nginx/templates. NGINX_ENVSUBST_FILTER is
# set in the Dockerfile so only SB_ names are substituted and nginx's own $host,
# $remote_addr and friends survive untouched.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${SB_FRONTEND_PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # An upload too large is refused here rather than after the API has read it.
  # CSV_MAX_BYTES defaults to 10 MB, and this has to leave room for the
  # multipart wrapper around it.
  client_max_body_size ${SB_MAX_UPLOAD_SIZE};

  # Everything the API owns. /health is proxied too, so a probe against this
  # container reports whether the pair works rather than whether nginx started.
  #
  # `(/|$)` and not a bare `/`: /mcp is registered both with and without its
  # slash and discovery advertises the bare form, so requiring the slash hands
  # every correctly configured MCP client the application shell instead. It also
  # keeps /mcpanel and anything else merely starting with these letters out.
  location ~ ^/(api|mcp|health|\.well-known)(/|$) {
    proxy_pass ${SB_API_ORIGIN};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Replaced, not appended. `$proxy_add_x_forwarded_for` keeps whatever the
    # caller sent and adds to it, so with TRUST_PROXY=true the server would
    # count sign-in attempts against an address the caller chose.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The API compares Origin against APP_BASE_URL on every state-changing
    # request, so the browser's own value has to survive the hop.
    proxy_set_header Origin $http_origin;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # MCP streams, and a response held open for minutes is ordinary there.
    proxy_read_timeout 600s;
    proxy_buffering off;
  }

  # Vite puts a content hash in every asset filename, so a name never changes
  # meaning and can be kept indefinitely.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # The shell is the opposite: its name never changes and its contents do, and
  # it is what names the hashed assets. Revalidated every time, so an upgrade
  # cannot leave somebody holding a page asking for assets that are gone.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
