DATABASE_URL=postgresql://simple_balance:change-me@database.example:5432/simple_balance
APP_BASE_URL=https://simple-balance.example.com
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_MODE=local
# Optional: choose the one-time first-owner code instead of reading a generated
# code from the startup log.
# SETUP_TOKEN=replace-with-a-long-random-first-run-code

# Required only when AUTH_MODE=google or AUTH_MODE=both:
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# ALLOWED_EMAILS=you@example.com

PORT=3000
LOG_LEVEL=info
CSV_MAX_BYTES=10485760
CSV_MAX_ROWS=25000
DATABASE_POOL_SIZE=10
TRUST_PROXY=false
