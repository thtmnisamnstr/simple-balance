DATABASE_URL=postgresql://simple_balance:change-me@database.example:5432/simple_balance
APP_BASE_URL=https://simple-balance.example.com
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_MODE=local
# Optional: choose the one-time code that creates the first account instead of
# reading a generated one from the startup log.
# SETUP_TOKEN=replace-with-a-long-random-first-run-code

# Who may register. Unset means nobody but the first account, which is what
# keeps an unconfigured deployment private. Entries may be addresses
# (you@example.com), domains (example.com or @example.com), or * for anybody.
# Required, and must admit somebody, when AUTH_MODE=google or AUTH_MODE=both.
# ALLOWED_EMAILS=you@example.com

# Required only when AUTH_MODE=google or AUTH_MODE=both:
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

PORT=3000
LOG_LEVEL=info
CSV_MAX_BYTES=10485760
CSV_MAX_ROWS=25000
DATABASE_POOL_SIZE=10
TRUST_PROXY=false
