DATABASE_URL=postgresql://simple_balance:change-me@database.example:5432/simple_balance
APP_BASE_URL=https://simple-balance.example.com
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_MODE=local
# Optional: choose the one-time code that creates the first account instead of
# reading a generated one from the startup log.
# SETUP_TOKEN=replace-with-a-long-random-first-run-code

# Who may register. Unset means nobody but the first account, which is what
# keeps an unconfigured deployment private. Entries may be addresses
# (you@example.com), domains (example.com or @example.com), or * for anybody.
# Required, and must admit somebody, when AUTH_MODE=google or AUTH_MODE=both.
# ALLOWED_EMAILS=you@example.com

# Required only when AUTH_MODE=google or AUTH_MODE=both:
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: a mail server. Set SMTP_HOST and MAIL_FROM together and people can
# reset a forgotten password, and a new account has to confirm its address
# before it works. Leave both unset and neither happens.
# Use a submission service, not the MX host your domain publishes: an MX record
# says where mail TO your domain is delivered, and will not accept mail from you.
# SMTP_HOST=smtp.example.com
# MAIL_FROM=Simple Balance <balance@example.com>
# Optional, for when the relay will not let messages claim MAIL_FROM as the
# sender and replies would otherwise go somewhere nobody reads.
# MAIL_REPLY_TO=Simple Balance <support@example.com>
# SMTP_PORT=587
# SMTP_SSL=false        # true for implicit TLS on 465
# SMTP_USERNAME=balance@example.com
# SMTP_PASSWORD=an-app-password-not-the-account-password

PORT=3000
LOG_LEVEL=info
CSV_MAX_BYTES=10485760
CSV_MAX_ROWS=25000
DATABASE_POOL_SIZE=10
TRUST_PROXY=false
