# ==============================================================================
# Core — required for every deployment
# ==============================================================================

# PostgreSQL 15 or later. The database named here is created if the server
# does not have it yet. Encrypt and verify this connection whenever it leaves
# the host; see "TLS" in docs/deployment.md for which sslmode to use.
# DATABASE_URL_FILE names a file holding it instead. Set one, never both.
DATABASE_URL=postgresql://simple_balance:change-me@database.example:5432/simple_balance

# Your canonical public origin, exactly as the browser sees it: no path, no
# query, no trailing slash. HTTPS anywhere but localhost. This is load-bearing
# beyond cosmetics — secure cookies, OAuth issuer metadata, redirect
# validation and the audience on MCP tokens are all derived from it. Get it
# wrong and sign-in fails in ways that look unrelated.
APP_BASE_URL=https://simple-balance.example.com

# production, development, or test. Every published image sets this for you;
# a host running `npm start` does not, and unset reads as development — which
# costs you the first-run setup code, sign-in rate limiting, and cookies
# marked secure, with nothing said about it.
# NODE_ENV=production

# At least 32 random characters: openssl rand -base64 32
# Changing it signs everyone out, so keep it. A value published in this
# project's own files, including whatever .env.example carries, is refused by
# name — so replace the empty value below before starting.
# AUTH_SECRET_FILE names a file holding it instead. Set one, never both.
AUTH_SECRET=

# ==============================================================================
# Sign-in and registration
# ==============================================================================

# local, google, or both. local needs nothing else in this section.
AUTH_MODE=local

# Who may register, on every sign-up path. Unset admits nobody but the first
# account, which is what keeps an unconfigured deployment private — that is
# the setting for a single household running this for itself. Entries may be
# addresses (you@example.com), domains (example.com or @example.com), or *
# for anybody. Required, and must admit somebody, when AUTH_MODE is google or
# both.
# ALLOWED_EMAILS=you@example.com

# The one-time code that claims a fresh instance. Left unset, one is
# generated and printed to the startup log, which is the usual choice for a
# single operator standing this up themselves.
# SETUP_TOKEN_FILE names a file holding it instead. Set one, never both.
# SETUP_TOKEN=replace-with-a-long-random-first-run-code

# --- Google sign-in — only if AUTH_MODE is google or both -------------------
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET_FILE names a file holding it instead. Set one, never both.
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# Legal pages — optional, no deployment is required to publish either
# ==============================================================================

# An absolute https:// address. Set it and the app links it from the sign-in
# and sign-up screens and from the sidebar on every page — the sign-up form is
# where a name and an address are first collected. Becomes REQUIRED the
# moment AdSense is configured below: Google's program policies demand one on
# any site serving their ads, and the server refuses to start without it.
# PRIVACY_POLICY_URL=https://simple-balance.example.com/privacy/

# An absolute https:// address. With it set, the sign-up form and the
# Continue with Google button each say that creating an account accepts
# these terms, and the plan tab links them beside its renewal terms.
# TERMS_OF_USE_URL=https://simple-balance.example.com/terms/

# ==============================================================================
# Mail — optional. Setting SMTP_HOST and MAIL_FROM together turns on password
# reset, address confirmation for new accounts, and the scheduled reminders
# that go by email (a recurring transaction proposing itself, a template
# reminder). Leave both unset and none of it happens — nothing queues, so a
# reminder whose moment passed while mail was off is not sent late once it is
# configured. Whether mail actually arrives also depends on SPF, DKIM, DMARC
# and a PTR record in your DNS; see "Getting mail delivered" in
# docs/deployment.md.
# ==============================================================================

# SMTP_HOST=smtp.example.com
# MAIL_FROM=Simple Balance <balance@example.com>
# MAIL_REPLY_TO=Simple Balance <support@example.com>
# SMTP_PORT=587
# True for a connection encrypted from the first byte (what port 465 expects).
# False starts on 587 and upgrades with STARTTLS, which nearly every provider
# wants.
# SMTP_SSL=false
# SMTP_USERNAME=balance@example.com
# Do not quote it. This file is read by `docker run --env-file`, which passes
# the value through as typed, so quote marks end up inside the password. A
# file this process cannot read stops the whole server, not only mail.
# SMTP_PASSWORD_FILE names a file holding it instead. Set one, never both.
# SMTP_PASSWORD=an-app-password-not-the-account-password

# ==============================================================================
# Billing — optional, and only relevant if you are running a hosted service
# for other people. A single self-hosted deployment for yourself or your
# household has no reason to enable any of this: every feature is already
# available to every account with no plan distinction at all.
#
# The five STRIPE_* settings only mean this deployment CAN reach Stripe.
# SB_BILLING_ENABLED is the separate decision to actually sell anything: set
# it to true and a free account is held to three financial accounts in use
# and offered an upgrade; leave it false (or leave all six unset) and nobody
# is limited, no matter what else here is configured. They are two settings
# on purpose — winding a deployment down means you stop selling months before
# you stop honoring the subscriptions people already paid for.
# ==============================================================================

# SB_BILLING_ENABLED=false
# The key this process charges, refunds and cancels with. A restricted key,
# rk_..., is what docs/billing-operations.md's setup walks you through
# building, and it must carry PaymentIntents: Write and must NOT be
# agent-tagged. A live key (sk_live_... or rk_live_...) outside
# NODE_ENV=production refuses to start: a test run that charges a real card
# is not something an apology fixes.
# STRIPE_SECRET_KEY_FILE names a file holding it instead. Set one, never both.
# STRIPE_SECRET_KEY=sk_test_replace-with-your-own
# The key the browser loads Stripe's payment form with. Published to every
# visitor by design, so it is a setting rather than a secret. A live key here
# beside a test secret key, or the reverse, refuses to start.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-own
# What a delivery from Stripe is verified against. Without it a forged
# request could tell this deployment an invoice was paid.
# STRIPE_WEBHOOK_SECRET_FILE names a file holding it instead. Set one, never both.
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-own
# Two prices on one product: $3 a month and $30 a year. A product id where a
# price id belongs is the usual mistake, and startup refuses it rather than
# failing at the first checkout.
# STRIPE_PRICE_MONTHLY_ID=price_replace-with-your-own
# STRIPE_PRICE_YEARLY_ID=price_replace-with-your-own

# Rehearses the plan and billing tab's content security policy instead of
# enforcing it, for the hour after you first turn billing on against a real
# Stripe account: that one page reports what its policy would have blocked
# (POST /api/csp-report is registered to receive the reports) and blocks
# nothing, while every other page — including any page carrying an ad —
# keeps enforcing throughout. Never leave it on: the process warns at every
# startup while it is set, because a rehearsal nobody remembers to turn off
# looks exactly like a working deployment from the outside.
# SB_CSP_REPORT_ONLY=false

# ==============================================================================
# Advertising — optional, and only relevant alongside billing above: ads are
# shown only to a free-plan account on a deployment that is actually selling
# a plan (SB_BILLING_ENABLED=true with Stripe configured). With billing off,
# nobody is on a limited plan, so these would serve ads.txt and widen the
# content security policy on every page without ever showing anyone an ad.
# A client id and a banner slot go together; know the cost before setting
# them — Google publishes no fixed host list for what AdSense loads, so
# serving it widens this app's CSP on every page that shows your balances,
# including allowing scripts to be evaluated at runtime.
# ==============================================================================

# The AdSense publisher id, ca-pub- followed by sixteen digits. The AdSense
# dashboard shows it as pub-..., and the missing ca- prefix is refused at
# startup rather than failing silently by rendering nothing.
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# The ad unit shown once in the application shell. Ten digits.
# ADSENSE_BANNER_SLOT_ID=0000000000
# A second unit at the bottom of the page. Off unless set, and an addition to
# the banner rather than a replacement — setting it alone refuses to start.
# ADSENSE_FOOTER_SLOT_ID=0000000000
# Whether ads may be personalized. Off by default, and that is the point:
# personalized advertising profiles the person reading the page, and this
# page is showing them their own money. Turning it on asserts you have a
# certified consent platform published in AdSense's own Privacy and
# messaging — required for EEA and UK traffic even for non-personalized
# ads. Nothing here can check that the platform actually exists.
# ADSENSE_CONSENT_MANAGED=false
# PRIVACY_POLICY_URL, above, is REQUIRED the moment ADSENSE_CLIENT_ID is set.

# ==============================================================================
# Metrics — optional. Off unless you run Prometheus or something that scrapes
# its format.
# ==============================================================================

# Whether this process answers GET /metrics in Prometheus' text format. No
# label names a person or an amount; what it publishes is how much this
# deployment is doing.
# METRICS_ENABLED=false
# A bearer token GET /metrics demands before it answers. Leave it unset only
# behind a private network nothing else can reach.
# METRICS_TOKEN_FILE names a file holding it instead. Set one, never both.
# METRICS_TOKEN=

# ==============================================================================
# Server — defaults that work for a single container. Change only if you know
# why.
# ==============================================================================

PORT=3000
# debug, info, warn, or error. debug adds a line per HTTP request, per MCP
# tool call, per message sent and per scheduler tick that found nothing due;
# info keeps startup, mail, shutdown and the ticks that actually proposed or
# reminded. A startup refusal is always reported, whatever this is set to.
LOG_LEVEL=info

# Turn this on only when a reverse proxy sits in front and replaces
# X-Forwarded-For. Left off behind one, every visitor shares a single
# sign-in rate limit; turned on without a proxy in front, a visitor can set
# their own X-Forwarded-For and spend somebody else's limit.
TRUST_PROXY=false

# ==============================================================================
# Limits — defaults match what the product is built and tested against.
# Lowering any of these is your business; raising one past its ceiling warns
# at startup and runs on the default instead.
# ==============================================================================

# Largest CSV accepted for import, in bytes. Ceiling 104857600 (100 MB).
CSV_MAX_BYTES=10485760
# Most rows accepted from one CSV. Ceiling 10000, which is also the most rows
# one mass edit, commit, or delete covers, so an import always fits a single
# review-queue action.
CSV_MAX_ROWS=10000
# Connections held open, per process. Ceiling 100. Raise it only if you have
# measured contention.
DATABASE_POOL_SIZE=10

# Only when PgBouncer or another transaction pooler sits in front of
# PostgreSQL. Migrations and the first-account claim hold a session-level
# advisory lock, which a transaction pooler cannot carry, so they use this
# connection string instead.
# DIRECT_DATABASE_URL_FILE names a file holding it instead. Set one, never both.
# DIRECT_DATABASE_URL=postgresql://user:password@postgres-direct:5432/simple_balance

# How long a used idempotency key keeps replaying, in hours. Zero, unset or
# empty all mean forever. Every create, commit and bulk write stores a copy
# of its response so a retried request answers the same way twice; nothing
# prunes those copies unless you set this, and on a busy deployment the
# table outgrows the ledger. Ceiling 8760 (one year). Needs
# RECURRENCE_SCHEDULER on somewhere, since the sweep that prunes rides its
# tick.
# IDEMPOTENCY_RETENTION_HOURS=0

# ==============================================================================
# Scheduler — whether THIS process proposes recurring transactions, sends
# reminders, and (where Stripe is configured) runs the twelve-hourly sweep
# that re-reads subscriptions Stripe stopped telling us about. On by default,
# so a single container needs nothing added here. Turn it off only on
# replicas that serve the API when a separate scheduler container owns the
# job — it has to be on somewhere, or a delivery Stripe gave up on leaves
# somebody on a plan they canceled.
# ==============================================================================

RECURRENCE_SCHEDULER=true
# How often it looks for work that has come due. Latency only for a
# recurrence — whatever a missed tick leaves behind, the next one catches up.
# A reminder whose moment passed is not sent late, so this is also how close
# to the requested time a reminder lands. Ceiling 3600.
RECURRENCE_TICK_SECONDS=300
# Most occurrences one recurrence catches up in one tick. Nothing is
# dropped; a tick that hits the cap comes straight back. Ceiling 500.
RECURRENCE_CATCH_UP_LIMIT=50
# Most recurrences examined in one tick. Ceiling 5000.
RECURRENCE_CLAIM_LIMIT=500

# ==============================================================================
# A note on secrets
#
# Nine names take a _FILE form, and having that form is what makes a name a
# secret here: AUTH_SECRET, DATABASE_URL, DIRECT_DATABASE_URL, SMTP_PASSWORD,
# GOOGLE_CLIENT_SECRET, SETUP_TOKEN, METRICS_TOKEN, STRIPE_SECRET_KEY, and
# STRIPE_WEBHOOK_SECRET. Every other name in this file is a setting, including
# ones that look sensitive — STRIPE_PUBLISHABLE_KEY and the AdSense ids ship
# to every browser by design, so calling them secrets would say something
# false. Set NAME_FILE to a file holding the value instead of NAME itself —
# a Docker secret, a Kubernetes secret volume, a systemd credential — never
# both for the same name. See "Keeping a secret out of the environment" in
# docs/deployment.md.
# ==============================================================================
